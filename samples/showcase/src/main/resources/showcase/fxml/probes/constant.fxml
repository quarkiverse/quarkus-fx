<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.Double?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<!-- fx:constant on java.lang.Double, Color and an enum -->
<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="3" prefWidth="116">
    <Button fx:id="subject" text="MAX_VALUE" mnemonicParsing="false">
        <maxWidth>
            <Double fx:constant="MAX_VALUE"/>
        </maxWidth>
    </Button>
    <Label fx:id="coral" text="Color.CORAL" maxWidth="Infinity">
        <textFill>
            <Color fx:constant="CORAL"/>
        </textFill>
        <alignment>
            <Pos fx:constant="CENTER_RIGHT"/>
        </alignment>
    </Label>
</VBox>
