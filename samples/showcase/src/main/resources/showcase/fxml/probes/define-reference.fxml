<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Circle?>
<!-- fx:define, $variable dereference, fx:reference and escaped $ -->
<HBox xmlns:fx="http://javafx.com/fxml/1" spacing="5" alignment="CENTER_LEFT">
    <fx:define>
        <Color fx:id="brand" red="0.0" green="0.59" blue="0.53"/>
        <String fx:id="caption" fx:value="shared"/>
    </fx:define>
    <Circle fx:id="subject" radius="12" fill="$brand"/>
    <Circle radius="12">
        <fill>
            <fx:reference source="brand"/>
        </fill>
    </Circle>
    <Label fx:id="captionLabel" text="$caption" textFill="$brand"/>
    <Label fx:id="escaped" text="\$1"/>
</HBox>
